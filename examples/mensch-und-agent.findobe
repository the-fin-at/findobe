                  "textAlign": null
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Schreibe direkt in einen Absatz und verwende die Formatierungsleiste."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "attrs": {
              "id": "aef37b4e-57f1-4f82-a882-73974826e526"
