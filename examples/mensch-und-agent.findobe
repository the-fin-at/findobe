                  "textAlign": null
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Lass deinen Agenten eine andere Stelle ändern oder einen Vorschlag hinterlassen."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "attrs": {
              "id": "5248c8c5-4afd-4447-8655-224cb59016c0"
            },
