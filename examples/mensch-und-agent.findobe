                  "textAlign": null
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Markiere eine Textstelle und ergänze rechts einen Kommentar."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "attrs": {
              "id": "9ae74c52-1178-42ab-95fd-e9fb20e39f13"
            },
