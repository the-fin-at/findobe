          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Mensch und Agent"
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "id": "8d761a6c-9eb9-418d-8e6c-cb3e488e7a83",
          "textAlign": null
        },
        "content": [
          {
            "type": "text",
            "text": "Dieses Dokument kannst du direkt bearbeiten. Ein Agent kann dieselben Inhalte über den lokalen Findobe-Zugang lesen, gezielt ändern und kommentieren."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "id": "48a83893-6592-4886-b366-20df8f4e40d5",
          "textAlign": null,
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Zusammenarbeit ausprobieren"
          }
        ]
      },
      {
        "type": "bulletList",
        "attrs": {
          "id": "8ff7dfbd-ae0f-4094-acd7-223b6b028dc6"
        },
        "content": [
          {
